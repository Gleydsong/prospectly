{
  "name": "prospectly",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma inteligente para encontrar, analisar e organizar oportunidades comerciais locais.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @prospectly/shared-types build && pnpm -r --parallel run dev",
    "dev:landing": "pnpm --filter @prospectly/landing dev",
    "build": "pnpm -r run build",
    "build:landing": "pnpm --filter @prospectly/landing build",
    "lint": "pnpm -r run lint",
    "test": "pnpm test:scripts && pnpm -r run test",
    "test:scripts": "node --test scripts/*.test.cjs",
    "typecheck": "pnpm --filter @prospectly/shared-types build && pnpm -r run typecheck",
    "db:generate": "pnpm --filter @prospectly/api exec prisma generate",
    "db:migrate": "pnpm --filter @prospectly/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @prospectly/api exec prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "postcss": ">=8.5.18",
      "nanoid@<3.3.18": "3.3.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "multer": ">=2.5.0",
      "sharp": "^0.35.5",
      "lodash": ">=4.18.0",
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "glob@>=10.2.0 <11": ">=10.5.0",
      "picomatch@>=4 <4.0.4": ">=4.0.4",
      "tmp": ">=0.2.6",
      "deepmerge-ts@<8": "8.0.0",
      "proxy-addr": "^2.0.8",
      "tinypool": "^2.1.2",
      "handlebars": "^4.7.10",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "brace-expansion@>=1 <1.1.20": "^1.1.20",
      "brace-expansion@>=4 <5.0.11": "^5.0.11",
      "undici": "^6.28.1",
      "source-map-js": "^1.2.2",
      "follow-redirects": ">=1.16.1",
      "vite": "^6.4.4",
      "body-parser": ">=2.4.0",
      "webpack": ">=5.104.1",
      "fast-uri": ">=3.1.9"
    }
  }
}
