{
  "name": "prospectly",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma inteligente para encontrar, analisar e organizar oportunidades comerciais locais.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @prospectly/shared-types build && pnpm -r --parallel run dev",
    "dev:landing": "pnpm --filter @prospectly/landing dev",
    "build": "pnpm -r run build",
    "build:landing": "pnpm --filter @prospectly/landing build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm --filter @prospectly/shared-types build && pnpm -r run typecheck",
    "db:generate": "pnpm --filter @prospectly/api exec prisma generate",
    "db:migrate": "pnpm --filter @prospectly/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @prospectly/api exec prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2",
        "GHSA-jqcg-44mw-7w3h",
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-85c8-ppgw-ccpr",
        "GHSA-8r5x-fm3f-whwj",
        "GHSA-p8wg-vrv2-v86f",
        "GHSA-qw65-cvwx-89v3",
        "GHSA-58mr-gqgx-xq4g",
        "GHSA-rfgv-xxqx-mfg5",
        "GHSA-qhr7-859c-m2p7",
        "GHSA-6j4f-fj2g-mc7p",
        "GHSA-v53p-9fqp-m79j",
        "GHSA-c29m-xwm3-cm6r",
        "GHSA-mghh-pgcx-3jjj",
        "GHSA-x97p-jq2g-jp4f",
        "GHSA-3pq3-5fj3-cg6v",
        "GHSA-542g-h47m-68v8",
        "GHSA-m8m8-qj5v-23w3",
        "GHSA-r4gj-5m52-g5wh",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-68fv-2mgg-jv7q",
        "GHSA-prgh-xp8r-p3m5",
        "GHSA-wq5f-xc86-pv6w",
        "GHSA-6qxp-vccf-f47h"
      ]
    },
    "overrides": {
      "postcss": ">=8.5.18",
      "nanoid@<3.3.18": "3.3.18",
      "fast-uri": ">=3.1.7",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "undici": ">=6.28.1",
      "axios": ">=1.20.0",
      "braces": ">=3.0.3",
      "source-map-js": ">=1.2.2",
      "nodemailer": ">=10.0.6",
      "sharp": ">=0.35.5",
      "@modelcontextprotocol/sdk": ">=1.31.0",
      "multer": "^2.3.0",
      "lodash": ">=4.18.0",
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "glob@>=10.2.0 <11": ">=10.5.0",
      "picomatch@>=4 <4.0.4": ">=4.0.4",
      "tmp": ">=0.2.6",
      "deepmerge-ts@<8": "8.0.0",
      "proxy-addr": ">=2.0.8",
      "tinypool": ">=2.1.2",
      "handlebars": ">=4.7.10"
    }
  }
}
