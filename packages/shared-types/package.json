{
  "name": "@prospectly/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo 'no tests'",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"const fs=require('node:fs'); fs.renameSync('dist/cjs/index.js','dist/cjs/index.cjs'); fs.writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\""
  },
  "devDependencies": {
    "@prospectly/tsconfig": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}
