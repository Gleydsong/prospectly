# Root example env — copy app-specific values from apps/api/.env.example and apps/web/.env.example
NODE_ENV=development

# Infrastructure (docker-compose) — LOCAL DEV ONLY.
# Defaults bind to 127.0.0.1; change passwords before any shared/remote use.
POSTGRES_USER=prospectly
POSTGRES_PASSWORD=prospectly
POSTGRES_DB=prospectly
POSTGRES_PORT=5432
REDIS_PORT=6379
