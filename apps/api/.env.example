NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://prospectly:prospectly@localhost:5432/prospectly?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Stripe billing (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_BRL=
STRIPE_PRICE_MONTHLY_EUR=
STRIPE_PRICE_MONTHLY_USD=
STRIPE_PRICE_LIFETIME_BRL=
STRIPE_PRICE_LIFETIME_EUR=
STRIPE_PRICE_LIFETIME_USD=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/settings

# OpenStreetMap provider (Phase 3)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=Prospectly/1.0 (https://prospectly.dev)
OSM_TIMEOUT_MS=45000
OSM_RESULT_LIMIT=100
CSV_MAX_FILE_SIZE_BYTES=5242880
CSV_MAX_ROWS=10000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# External providers (Phase 3+)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_MS=30000
GOOGLE_PLACES_RESULT_LIMIT=20
YELP_API_KEY=
PAGESPEED_API_KEY=

# Email (used for password reset / verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@prospectly.dev

# Observability
SENTRY_DSN=
LOG_LEVEL=debug
