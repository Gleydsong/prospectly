NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://prospectly:prospectly@localhost:5432/prospectly?schema=public
# Prisma pool (P2028). Code adds connection_limit + pool_timeout when they are absent:
#   ROLE=api (HTTP)     → connection_limit=5  pool_timeout=10
#   ROLE=worker (BullMQ) → connection_limit=3  pool_timeout=10
# Relatórios also sets statement_timeout=8s inside its read transaction.
# Do not raise the limits without checking Postgres max_connections on Render (wizard after merge).
# Runtime role without BYPASSRLS. The migration creates it as NOLOGIN; provision a secret externally.
# Leave unset locally to use DATABASE_URL (owner).
# DATABASE_APP_URL=postgresql://prospectly_app:<strong-generated-password>@localhost:5432/prospectly?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# lax for same-site/local HTTP. Production on distinct *.onrender.com hosts needs none (Secure).
# After api.prospectlyonboard.com is live and VITE_API_URL points there, set lax (app + api share site).
# Never set Domain=.onrender.com. Do not switch to lax while the app still calls prospectly-api.onrender.com.
# REFRESH_COOKIE_SAME_SITE=lax

FRONTEND_URL=http://localhost:5173
MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# New PIX and cards go through Asaas.
# Code default: ASAAS_ENABLED unset → disabled. This example mirrors the authorized PIX cutover.
# Local without Sandbox keys: PIX_PROVIDER=DISABLED and ASAAS_ENABLED=false.
# PIX_PROVIDER=ASAAS requires ASAAS_ENABLED=true and non-empty Asaas secrets or the API will not boot.
PIX_PROVIDER=ASAAS
ASAAS_ENABLED=true
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_HTTP_TIMEOUT_MS=15000

# OpenStreetMap provider (Phase 3)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter
OSM_USER_AGENT=Prospectly/1.0 (https://prospectly.dev)
OSM_TIMEOUT_MS=20000
OSM_RESULT_LIMIT=100
CSV_MAX_FILE_SIZE_BYTES=5242880
CSV_MAX_ROWS=10000

# Website analysis (Phase 4)
WEBSITE_ANALYSIS_TIMEOUT_MS=10000
WEBSITE_ANALYSIS_MAX_BODY_BYTES=1500000
WEBSITE_ANALYSIS_MAX_REDIRECTS=5

# OAuth — Google Sign-In (ID token / GIS). Client ID is public; used by API to verify tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Conexão Google (Gmail/Calendar read). Separate consent from Sign-In. Wizard: consent screen + redirect URI.
# Production cutover (#179): https://api.prospectlyonboard.com/api/v1/google-connections/callback
# Strip trailing newlines in GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (Render paste → invalid_client).
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/google-connections/callback
# 32-byte key as 64 hex chars. Required to complete a Conexão Google.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# External providers (Phase 3+)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_MS=30000
GOOGLE_PLACES_RESULT_LIMIT=20
YELP_API_KEY=
PAGESPEED_API_KEY=

# Email — prefer Resend when RESEND_API_KEY is set; otherwise SMTP (noop if SMTP_HOST empty)
RESEND_API_KEY=
RESEND_FROM=Prospectly <hello@prospectlyonboard.com>
# Dev-only HTML previews at /api/v1/email-preview/:id — never enable in production/staging
EMAIL_PREVIEW=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@prospectlyonboard.com

# Waitlist (landing) — optional internal notify on new signup
WAITLIST_NOTIFY_TO=

# Demo seed (local). Production requires ALLOW_PROD_SEED=true and SEED_DEMO_PASSWORD.
SEED_DEMO_PASSWORD=Demo123!
# ALLOW_PROD_SEED=true

# Observability
SENTRY_DSN=
LOG_LEVEL=debug
# Platform ops snapshot (GET /api/v1/ops/metrics). Leave empty to hide the route (404).
# When set, must be at least 32 characters. Send as header X-Prospectly-Ops-Token.
OPS_METRICS_TOKEN=

# Agent WhatsApp AI (Ollama). If Ollama is down/disabled, API uses deterministic fallback.
# Local Ollama for WhatsApp first-message variants (fallback packs if offline).
# Prefer qwen3:8b (PT-BR). Stronger: qwen3:14b (needs more VRAM + higher timeout).
WHATSAPP_AI_ENABLED=true
WHATSAPP_AI_BASE_URL=http://127.0.0.1:11434
WHATSAPP_AI_MODEL=qwen3:8b
WHATSAPP_AI_TIMEOUT_MS=30000
WHATSAPP_AI_API_KEY=

# Jev / TypeSafe. Judges a lead before the writer is called. Empty key fails closed.
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_TIMEOUT_MS=20000

# AI Opportunity Finder (uses Unified AI Provider Layer #369)
OPPORTUNITY_AI_ENABLED=true
# Optional model override (defaults to AI_MODEL: @cf/openai/gpt-oss-120b)
# OPPORTUNITY_AI_MODEL=@cf/openai/gpt-oss-120b

# Unified AI Provider Layer (#369) — Cloudflare Workers AI with Groq Fallback
# Values: cloudflare | groq | disabled
AI_PROVIDER=disabled
AI_MODEL=@cf/openai/gpt-oss-120b
# Fallback provider when primary fails (timeout, 429, 5xx): groq | none
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI credentials (OpenAI-compatible /ai/v1)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# Groq fallback credentials (OpenAI-compatible /openai/v1)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Timeouts, retries and daily token budget per organization
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_BUDGET_TOKENS=100000
