generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  OWNER
  ADMIN
  SALES
  MEMBER
  VIEWER
}

enum AppLocale {
  pt
  en
}

enum LeadStatus {
  NEW
  TO_REVIEW
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  RESPONDED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum LeadSource {
  MANUAL
  CSV_IMPORT
  GOOGLE_PLACES
  OPENSTREETMAP
  YELP
  REFERRAL
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  INSTAGRAM
  MEETING
  NOTE
  TASK
  PROPOSAL_SENT
  STATUS_CHANGED
  OWNER_CHANGED
  STAGE_CHANGED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum SavedViewVisibility {
  PRIVATE
  TEAM
}

enum SavedViewResourceType {
  LEAD
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowStepRunOutcome {
  APPLIED
  SKIPPED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignLeadResult {
  CONTACTED
  REPLIED
  INTERESTED
  MEETING
  PROPOSAL
  WON
  LOST
  NO_RESPONSE
  OPT_OUT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WebsitePresence {
  NO_WEBSITE_REPORTED
  WEBSITE_FOUND
  NEEDS_REVIEW
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IssueSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Commercial opportunity derived from the SEO health score (inverse relation).
enum SeoOpportunityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OrgPlan {
  FREE
  STARTER_MONTHLY
  LIFETIME
}

enum PlanStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  STRIPE
  ABACATE
  ASAAS
}

enum CreditPurchaseStatus {
  PENDING
  REVIEW_REQUIRED
  COMPLETED
  REFUNDED
  FAILED
}

enum BillingPaymentMethod {
  PIX
  CARD
}

enum BillingWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  REVIEW_REQUIRED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum BillingCheckoutAttemptStatus {
  PROCESSING
  READY
  REVIEW_REQUIRED
  RESOLVED
  FAILED
}

/// Reasons for credit balance movements. SEARCH_CONSUME (Maps), AI_CONSUME (Opportunity Finder / explain / save lead),
/// SIGNUP_BONUS, PURCHASE and REFUND (failed paid actions return the consumed amount).
enum CreditLedgerReason {
  SEARCH_CONSUME
  SIGNUP_BONUS
  PURCHASE
  PURCHASE_REVERSAL
  REFUND
  AI_CONSUME
}

enum OpportunityRunStatus {
  IDLE
  PREPARING
  SEARCHING
  ANALYZING
  RANKING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum OpportunityCandidateStatus {
  DISCOVERED
  ANALYZING
  SCORED
  FAILED
}

enum AiRunStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------- Identity & tenancy ----------

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  pendingEmail         String?   @unique
  name                 String
  passwordHash         String?
  avatarUrl            String?
  googleId             String?   @unique
  githubId             String?   @unique
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?
  emailVerifyTokenExpiresAt DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  locale               AppLocale @default(pt)
  termsAcceptedAt      DateTime?
  termsVersion         String?
  privacyAcceptedAt    DateTime?
  anonymizedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  ownedLeads    Lead[]               @relation("LeadOwner")
  activities    LeadActivity[]
  assignedTasks Task[]               @relation("TaskAssignee")
  createdTasks  Task[]               @relation("TaskCreator")
  searches      Search[]
  imports       Import[]
  campaigns           Campaign[]
  templates           MessageTemplate[]
  campaignActivities  CampaignActivity[]
  auditLogs           AuditLog[]
  dataRequests        DataSubjectRequest[]
  reviewedDataRequests DataSubjectRequest[] @relation("DataSubjectRequestReviewer")
  opportunityRuns      OpportunityRun[]
  aiRuns               AiRun[]
  consents             ConsentRecord[]
  savedViews           SavedView[]
  workflows            Workflow[]
  googleConnections    GoogleConnection[]

  @@index([email])
}

model Organization {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  paymentProvider       PaymentProvider?
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?          @unique
  abacateCustomerId     String?          @unique
  abacateSubscriptionId String?          @unique
  abacatePaymentId      String?          @unique
  asaasSubscriptionId  String?          @unique
  asaasPaymentId       String?          @unique
  plan                  OrgPlan          @default(FREE)
  planStatus            PlanStatus       @default(INACTIVE)
  planCurrency          String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  creditBalance         Int              @default(400)

  members      OrganizationMember[]
  leads        Lead[]
  tags         Tag[]
  activities   LeadActivity[]
  tasks        Task[]
  pipelines    Pipeline[]
  searches     Search[]
  imports      Import[]
  campaigns          Campaign[]
  templates          MessageTemplate[]
  campaignActivities CampaignActivity[]
  scoreConfigs       ScoreConfiguration[]
  integrations       Integration[]
  pluginTokens       PluginToken[]
  auditLogs          AuditLog[]
  usageLedgers       UsageLedger[]
  creditPurchases    CreditPurchase[]
  monthlyCheckoutAttempts MonthlyCheckoutAttempt[]
  billingProfile          BillingProfile?
  creditLedgerEntries CreditLedgerEntry[]
  opportunityRuns     OpportunityRun[]
  aiRuns              AiRun[]
  dataSubjectRequests DataSubjectRequest[]
  suppressionEntries  SuppressionEntry[]
  outboxEvents        OutboxEvent[]
  savedViews          SavedView[]
  workflows           Workflow[]
  workflowVersions    WorkflowVersion[]
  workflowStepRuns    WorkflowStepRun[]
  customFieldDefinitions CustomFieldDefinition[]
  googleConnections      GoogleConnection[]
  syncedCommunications   SyncedCommunication[]

  @@index([planStatus])
  @@index([stripeCustomerId])
  @@index([abacateCustomerId])
  @@index([asaasSubscriptionId])
  @@index([asaasPaymentId])
  @@index([paymentProvider])
}

/// Consent grant/withdrawal history for the account holder (not lead outreach).
model ConsentRecord {
  id                    String    @id @default(uuid())
  userId                String
  type                  String
  granted               Boolean
  version               String
  source                String
  privacyPolicyVersion  String?
  termsVersion          String?
  grantedAt             DateTime  @default(now())
  withdrawnAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

/// Hashed identifiers that must not be re-imported after opt-out / erasure.
model SuppressionEntry {
  id             String   @id @default(uuid())
  organizationId String
  kind           String
  valueHash      String
  source         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, valueHash])
  @@index([organizationId, kind])
}

model DataSubjectRequest {
  id                   String    @id @default(uuid())
  userId               String
  organizationId       String?
  type                 String
  status               String    @default("PENDING")
  notes                String?
  reviewedById         String?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  completedAt          DateTime?
  confirmationSentAt   DateTime?
  confirmationChannel  String?
  confirmationNote     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("DataSubjectRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([organizationId, status])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  tokenHash      String    @unique
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

// ---------- Leads ----------

model Lead {
  id             String  @id @default(uuid())
  organizationId String
  ownerId        String?
  stageId        String?

  companyName  String
  tradeName    String?
  category     String?
  segment      String?
  description  String?
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  domain       String?
  instagram    String?
  facebook     String?
  linkedin     String?
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  rating       Float?
  reviewCount  Int?
  openingHours Json?
  customFieldValues Json @default("{}")

  source             LeadSource      @default(MANUAL)
  externalId         String?
  status             LeadStatus      @default(NEW)
  websitePresence      WebsitePresence  @default(NEEDS_REVIEW)
  websiteCheckedAt     DateTime?
  websiteCheckSource   String?
  websiteStatusReason  String?
  confidenceLevel      ConfidenceLevel?
  lastVerifiedAt       DateTime?
  score                Int              @default(0)
  notes                String?
  probableDuplicateKey String?

  doNotContact    Boolean   @default(false)
  consentAt       DateTime?
  dataCollectedAt DateTime?

  lastContactAt DateTime?
  nextContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stage         PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  contacts      LeadContact[]
  tags          LeadTag[]
  activities         LeadActivity[]
  syncedCommunications SyncedCommunication[]
  tasks              Task[]
  websiteRecord      Website?
  scores             LeadScore[]
  campaignLeads      CampaignLead[]
  campaignActivities CampaignActivity[]
  searchResults      SearchResult[]
  opportunityCandidates OpportunityCandidate[]

  @@unique([organizationId, source, externalId])
  @@unique([organizationId, domain])
  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@unique([organizationId, probableDuplicateKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, city])
  @@index([organizationId, deletedAt])
}

model LeadContact {
  id        String   @id @default(uuid())
  leadId    String
  name      String
  role      String?
  email     String?
  phone     String?
  whatsapp  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
}

model CustomFieldDefinition {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  type           CustomFieldType
  position       Int
  options        Json            @default("[]")
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unique (organizationId, name) among active rows is a partial unique index in SQL.
  @@index([organizationId, archivedAt])
  @@index([organizationId, position])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  userId         String
  type           ActivityType
  description    String?
  outcome        String?
  nextAction     String?
  followUpAt     DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
}

model Task {
  id               String       @id @default(uuid())
  organizationId   String
  leadId           String?
  assigneeId       String?
  createdById      String
  campaignId       String?
  campaignStageId  String?
  title            String
  description      String?
  dueAt            DateTime?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(OPEN)
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, campaignStageId, leadId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([leadId])
  @@index([campaignId, campaignStageId])
}

// ---------- Pipeline ----------

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@index([organizationId])
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String
  order      Int
  color      String?
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
}

// ---------- Website analysis (Phase 4) ----------

model Website {
  id        String   @id @default(uuid())
  leadId    String   @unique
  url       String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  analyses WebsiteAnalysis[]
}

model WebsiteAnalysis {
  id                String         @id @default(uuid())
  websiteId         String
  status            AnalysisStatus @default(PENDING)
  httpStatus        Int?
  https             Boolean?
  sslValid          Boolean?
  redirectsToHttps  Boolean?
  responseTimeMs    Int?
  title             String?
  metaDescription   String?
  hasViewport       Boolean?
  hasContactForm    Boolean?
  hasPhone          Boolean?
  hasEmail          Boolean?
  hasSocialLinks    Boolean?
  hasWhatsapp       Boolean?
  hasBooking        Boolean?
  hasPrivacyPolicy  Boolean?
  hasSitemap        Boolean?
  hasRobotsTxt      Boolean?
  hasFavicon        Boolean?
  hasOpenGraph      Boolean?
  hasStructuredData Boolean?
  cms               String?
  framework         String?
  analytics         String?
  technologies      Json?
  screenshotUrl     String?
  /// SEO audit (slice 1): 0-100 health, inverse opportunity, detected architecture, full audit payload.
  seoHealthScore    Int?
  seoOpportunity    SeoOpportunityLevel?
  architecture      String?
  seoAudit          Json?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  website Website                @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  issues  WebsiteAnalysisIssue[]

  @@index([websiteId, createdAt])
  @@index([status])
}

model WebsiteAnalysisIssue {
  id         String        @id @default(uuid())
  analysisId String
  code       String
  severity   IssueSeverity
  message    String
  createdAt  DateTime      @default(now())

  analysis WebsiteAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// ---------- Scoring (Phase 4) ----------

model ScoreConfiguration {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @default("default")
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        ScoreRule[]

  @@index([organizationId, isActive])
}

model ScoreRule {
  id          String   @id @default(uuid())
  configId    String
  key         String
  description String?
  points      Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  config ScoreConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, key])
}

model LeadScore {
  id                String   @id @default(uuid())
  leadId            String
  score             Int
  fit               Int      @default(0)
  opportunity       Int      @default(0)
  engagement        Int      @default(0)
  tier              String
  rulesApplied      Json
  missingData       Json
  recommendedAction String?
  configVersion     Int
  calculatedAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, calculatedAt])
}

// ---------- Search & imports (Phase 3) ----------

model Search {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  provider       String
  input          Json
  status         SearchStatus @default(PENDING)
  error          String?
  correlationId  String?
  jobDispatchedAt DateTime?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  results      SearchResult[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([organizationId, createdAt])
  @@index([status, jobDispatchedAt])
}

model SearchResult {
  id              String          @id @default(uuid())
  searchId        String
  externalId      String?
  data            Json
  websitePresence WebsitePresence
  normalizedData  Json
  importedLeadId  String?
  createdAt       DateTime        @default(now())

  search       Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  importedLead Lead?  @relation(fields: [importedLeadId], references: [id], onDelete: SetNull)

  @@unique([searchId, externalId])
  @@index([searchId])
}

// ---------- AI Opportunity Finder ----------

model OpportunityRun {
  id                 String               @id @default(uuid())
  organizationId     String
  userId             String
  status             OpportunityRunStatus @default(PREPARING)
  service            String
  city               String
  state              String
  country             String               @default("BR")
  profile             Json?
  searchStrategy      Json?
  scoringVersion      String               @default("opportunity-score-v1")
  profilePromptVersion String?
  strategyPromptVersion String?
  candidateCount      Int                  @default(0)
  analyzedCount       Int                  @default(0)
  failedCount         Int                  @default(0)
  errorCode           String?
  errorMessage        String?
  correlationId       String?
  idempotencyKey      String?
  jobDispatchedAt     DateTime?
  startedAt           DateTime             @default(now())
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates   OpportunityCandidate[]
  aiRuns       AiRun[]
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([userId, createdAt])
  @@index([status, jobDispatchedAt])
}

model OpportunityCandidate {
  id               String                     @id @default(uuid())
  runId            String
  status           OpportunityCandidateStatus @default(DISCOVERED)
  externalId       String
  provider         String
  company          Json
  websiteAnalysis  Json?
  signals          Json
  scoreBreakdown   Json
  overallScore     Int
  confidenceScore  Int
  dataCompleteness Int
  rankingCategory  String
  explanation      Json?
  explanationPromptVersion String?
  importedLeadId   String?
  analyzedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  run          OpportunityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  importedLead Lead?          @relation(fields: [importedLeadId], references: [id], onDelete: SetNull)
  aiRuns       AiRun[]

  @@unique([runId, externalId])
  @@index([runId, overallScore, confidenceScore])
  @@index([importedLeadId])
}

model AiRun {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  opportunityRunId String?
  candidateId    String?
  task           String
  provider       String
  model          String
  promptVersion  String
  status         AiRunStatus @default(PENDING)
  inputTokens    Int?
  outputTokens   Int?
  durationMs     Int?
  errorCode      String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityRun OpportunityRun?       @relation(fields: [opportunityRunId], references: [id], onDelete: Cascade)
  candidate      OpportunityCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([opportunityRunId])
  @@index([candidateId])
  @@index([task, status, createdAt])
}

model Import {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  fileName       String
  status         ImportStatus @default(PENDING)
  totalRows      Int          @default(0)
  importedCount  Int          @default(0)
  skippedCount   Int          @default(0)
  invalidCount   Int          @default(0)
  mapping        Json?
  stagedRows     Json?
  correlationId  String?
  jobDispatchedAt DateTime?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  errors       ImportError[]

  @@index([organizationId, createdAt])
  @@index([status, jobDispatchedAt])
}

model ImportError {
  id        String   @id @default(uuid())
  importId  String
  row       Int
  message   String
  data      Json?
  createdAt DateTime @default(now())

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@unique([importId, row])
}

// ---------- Campaigns & templates (Phase 5) ----------

model Campaign {
  id             String         @id @default(uuid())
  organizationId String
  ownerId        String?
  templateId     String?
  name           String
  description    String?
  segment        String?
  channel        String?
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  metrics        Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  template     MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  leads        CampaignLead[]
  tasks        Task[]
  activities   CampaignActivity[]

  @@index([organizationId, status])
}

model CampaignLead {
  campaignId      String
  leadId          String
  status          String              @default("PENDING")
  currentStageId  String?
  result          CampaignLeadResult?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  nextAction      String?
  addedAt         DateTime            @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([campaignId, leadId])
  @@index([leadId])
  @@index([campaignId, status])
  @@index([campaignId, currentStageId])
}

model CampaignActivity {
  id             String             @id @default(uuid())
  organizationId String
  campaignId     String
  leadId         String
  userId         String
  stageId        String?
  result         CampaignLeadResult
  note           String?
  nextAction     String?
  followUpAt     DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([organizationId, createdAt])
  @@index([leadId, createdAt])
}

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String
  createdById    String?
  name           String
  category       String
  subject        String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaigns    Campaign[]

  @@index([organizationId, category])
}

// ---------- Communications (Gmail/Calendar ingest) ----------

/// Per-user Google mailbox/calendar OAuth. Not Integration (org webhook).
model GoogleConnection {
  id                    String    @id @default(uuid())
  organizationId        String
  userId                String
  googleSubject         String
  googleEmail           String
  refreshTokenEncrypted String?
  scopes                String
  connectedAt           DateTime  @default(now())
  revokedAt             DateTime?
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingestedCommunications SyncedCommunication[]

  @@unique([organizationId, userId])
  @@index([organizationId, revokedAt])
  @@index([userId])
}

enum SyncedCommunicationChannel {
  EMAIL
  CALENDAR
}

enum SyncedCommunicationDirection {
  IN
  OUT
  EVENT
}

/// Matched Gmail/Calendar metadata on a Lead. Not LeadActivity and not mailbox body.
model SyncedCommunication {
  id                     String                         @id @default(uuid())
  organizationId         String
  leadId                 String
  channel                SyncedCommunicationChannel
  externalId             String
  threadId               String?
  occurredAt             DateTime
  direction              SyncedCommunicationDirection
  fromAddresses          Json
  toAddresses            Json
  ccAddresses            Json
  subject                String
  snippet                String
  htmlLink               String
  ingestedByConnectionId String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead                 Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ingestedByConnection GoogleConnection? @relation(fields: [ingestedByConnectionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, leadId, channel, externalId])
  @@index([organizationId, leadId, occurredAt])
  @@index([leadId, occurredAt])
}

// ---------- Platform ----------

model Integration {
  id             String   @id @default(uuid())
  organizationId String
  provider       String
  status         String   @default("DISABLED")
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model PluginToken {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  tokenHash      String    @unique
  tokenPrefix    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entity         String?
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

/// Durable domain fact plus delivery state. Not AuditLog and not LeadActivity.
model OutboxEvent {
  id              String            @id @default(uuid())
  organizationId  String
  type            String
  schemaVersion   Int               @default(1)
  aggregateType   String
  aggregateId     String
  actorId         String?
  correlationId   String?
  idempotencyKey  String
  payload         Json
  status          OutboxEventStatus @default(PENDING)
  attempts        Int               @default(0)
  lastError       String?
  jobDispatchedAt DateTime?
  processedAt     DateTime?
  failedAt        DateTime?
  retainUntil     DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([status, jobDispatchedAt])
  @@index([status, retainUntil])
  @@index([retainUntil])
  @@index([organizationId, type, aggregateId])
}

/// Named, tenant-owned query over Leads. Definition is allowlisted; not SQL.
model SavedView {
  id             String                @id @default(uuid())
  organizationId String
  ownerId        String
  name           String
  description    String?
  visibility     SavedViewVisibility   @default(PRIVATE)
  resourceType   SavedViewResourceType @default(LEAD)
  definition     Json
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, ownerId, visibility])
}

/// Organization-scoped automation. Draft definition is editable; published versions are immutable.
model Workflow {
  id                  String         @id @default(uuid())
  organizationId      String
  ownerId             String
  name                String
  description         String?
  status              WorkflowStatus @default(DRAFT)
  draftDefinition     Json
  publishedVersionId  String?
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions     WorkflowVersion[]

  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, status])
}

model WorkflowVersion {
  id             String   @id @default(uuid())
  organizationId String
  workflowId     String
  version        Int
  definition     Json
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns     WorkflowStepRun[]

  @@unique([workflowId, version])
  @@index([organizationId, workflowId])
}

/// Idempotent record of one published step against one DomainEvent. Redelivery must not duplicate LeadTag.
model WorkflowStepRun {
  id                 String                   @id @default(uuid())
  organizationId     String
  workflowId         String
  workflowVersionId  String
  eventId            String
  leadId             String
  stepIndex          Int
  outcome            WorkflowStepRunOutcome
  createdAt          DateTime                 @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowVersion  WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  @@unique([workflowVersionId, eventId, stepIndex])
  @@index([organizationId, eventId])
}

/// Provider-agnostic webhook idempotency for active and historical gateways.
model BillingWebhookEvent {
  id          String                     @id @default(uuid())
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json?
  status      BillingWebhookEventStatus  @default(PROCESSING)
  attempts    Int                        @default(1)
  lastError   String?
  createdAt   DateTime                   @default(now())
  processedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime                   @updatedAt

  @@unique([provider, eventId])
  @@index([processedAt])
  @@index([status, updatedAt])
}

/// Minimal organization-owned payer data. Card details never enter Prospectly.
model BillingProfile {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  name            String
  cpfCnpj         String
  phone           String
  email           String
  address         String?
  addressNumber   String?
  complement      String?
  province        String?
  postalCode      String?
  asaasCustomerId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([asaasCustomerId])
}

/// Durable idempotency state for recurring AbacatePay checkout creation.
model MonthlyCheckoutAttempt {
  id                 String                       @id @default(uuid())
  organizationId     String
  provider           PaymentProvider              @default(ABACATE)
  paymentMethod      BillingPaymentMethod
  product            String                       @default("MONTHLY_ACCESS")
  amountCentavos     Int                          @default(4999)
  currency           String                       @default("BRL")
  status             BillingCheckoutAttemptStatus @default(PROCESSING)
  externalId         String                       @unique
  externalCheckoutId String?                      @unique
  externalCustomerId String?
  checkoutUrl        String?
  attempts           Int                          @default(1)
  lastError          String?
  lastReconciledAt   DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, paymentMethod])
  @@index([status, updatedAt])
  @@index([provider, status, lastReconciledAt])
}

model CreditPurchase {
  id                String               @id @default(uuid())
  organizationId    String
  offer             String
  credits           Int
  amountCentavos    Int
  currency          String               @default("BRL")
  provider          PaymentProvider
  paymentMethod     BillingPaymentMethod?
  status            CreditPurchaseStatus @default(PENDING)
  externalId        String               @unique
  externalPaymentId String?              @unique
  checkoutUrl       String?
  lastReconciledAt  DateTime?
  completedAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries CreditLedgerEntry[]
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([provider, status, lastReconciledAt])
}

/// Append-only ledger of credit balance changes (audit of consumo / future purchase+AI).
model CreditLedgerEntry {
  id             String             @id @default(uuid())
  organizationId String
  reason         CreditLedgerReason
  /// Negative for consumption, positive for credit.
  delta          Int
  balanceAfter   Int
  searchId       String?
  opportunityRunId String?
  purchaseId     String?
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  search       Search?        @relation(fields: [searchId], references: [id], onDelete: SetNull)
  opportunityRun OpportunityRun? @relation(fields: [opportunityRunId], references: [id], onDelete: SetNull)
  purchase     CreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, reason, createdAt])
  @@index([searchId])
  @@index([opportunityRunId])
  @@index([purchaseId])
}

/// Public product waitlist (landing signup — not org CRM leads).
model WaitlistEntry {
  id         String    @id @default(cuid())
  email      String    @unique
  locale     AppLocale @default(pt)
  source     String?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@index([createdAt])
}

enum UsageMeterKey {
  SEARCHES
  PUBLISHED_PAGES
  PAGE_DRAFTS
  VERSION_HISTORY
  CSV_EXPORT
  AI_GENERATIONS
}

model UsageLedger {
  id             String        @id @default(uuid())
  organizationId String
  meterKey       UsageMeterKey
  amount         Int           @default(1)
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, meterKey, createdAt])
}
